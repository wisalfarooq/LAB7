<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textViewName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name:"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewNameValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="fill_me"
            android:textSize="20sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textViewHeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Height:"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewHeightValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="fill_me"
            android:textSize="20sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textViewMass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mass:"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewMassValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="fill_me"
            android:textSize="20sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textViewHairColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hair Color:"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewHairColorValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="fill_me"
            android:textSize="20sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textViewSkinColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skin Color:"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewSkinColorValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="fill_me"
            android:textSize="20sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textViewEyeColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eye Color:"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewEyeColorValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="fill_me"
            android:textSize="20sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textViewBirthYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Birth Year:"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewBirthYearValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="fill_me"
            android:textSize="20sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textViewGender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gender:"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewGenderValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="fill_me"
            android:textSize="20sp" />

    </LinearLayout>
</ScrollView>